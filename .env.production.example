# ============================================================
# 生产环境变量模板（服务器端使用，提交到 GitHub 的是本模板，无隐私信息）
# 部署时：cp .env.production.example .env  然后填写真实值
# 注意：真正的 .env 已被 .gitignore 忽略，绝不会上传到 GitHub
# ============================================================

# ===== 数据库（必改：MySQL root 密码，请使用强密码） =====
MYSQL_ROOT_PASSWORD=change-me-strong-password

# ===== AI 大模型（AI 助手 / 简历解析需要） =====
# 不填则 AI 相关功能不可用，其余功能正常
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== MongoDB（AI 对话记录） =====
MONGO_URL=mongodb://mongo:27017
MONGO_DB=boss_assistant

# ===== 后端 / 爬虫（一般无需修改） =====
API_HOST=0.0.0.0
API_PORT=8000
CDP_PORT=9222
LOGIN_TIMEOUT=300