# ========== 数据库配置 ==========
# MySQL 连接字符串（生产环境推荐）
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
MYSQL_URL=mysql+pymysql://root:root@localhost:3306/boss_db?charset=utf8mb4

# 如果没有 MySQL，可以使用 SQLite（无需安装）
# 取消下面这行的注释，并注释掉上面的 MYSQL_URL
# DB_URL=sqlite:///data/boss_db.sqlite3

# ========== Chrome CDP 配置 ==========
# Chrome 调试端口
CDP_PORT=9222

# Chrome 可执行文件路径（留空自动检测）
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Chrome 隔离 profile 目录
CHROME_PROFILE_DIR=~/.boss-zhipin-scraper/chrome-profile

# 登录超时时间（秒）
LOGIN_TIMEOUT=300

# ========== API 服务配置 ==========
API_HOST=0.0.0.0
API_PORT=8000

# ========== AI 大模型配置 ==========
# 支持任何兼容 OpenAI API 格式的大模型（DeepSeek、OpenAI、通义千问、Moonshot等）
# 切换大模型只需修改以下三个配置项即可

# 大模型 API Key（必填，不填则 AI 助手和简历解析功能不可用）
LLM_API_KEY=sk-your-api-key-here

# 大模型 API Base URL
# DeepSeek: https://api.deepseek.com
# OpenAI:   https://api.openai.com/v1
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
# Moonshot: https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.deepseek.com

# 大模型名称
# DeepSeek: deepseek-chat
# OpenAI:   gpt-4o / gpt-4o-mini
# 通义千问:  qwen-plus / qwen-turbo
# Moonshot: moonshot-v1-8k
LLM_MODEL=deepseek-chat

# ========== MongoDB 配置（AI助手对话记录存储） ==========
MONGO_URL=mongodb://localhost:27017
MONGO_DB=boss_assistant
